---
import HomeIntroduction from './HomeIntroduction.astro';
import '../../styles/components/home-hero.css';
---

<main id="main-content" class="home-main">
  <section
    class="home-hero"
    aria-label="Khahare Eco Tours"
    data-home-hero
    data-header-theme="light"
  >
    <figure class="home-hero__media" data-hero-media-frame>
      <video
        muted
        loop
        playsinline
        preload="metadata"
        poster="/images/home/khahare-hero-poster.webp"
        aria-hidden="true"
        data-hero-media
        data-hero-video
      >
        <source src="/video/Hero-Section.mp4" type="video/mp4" />
      </video>
    </figure>

    <a class="home-hero__scroll" href="#home-introduction" data-hero-scroll>
      <span>Scroll</span>
      <span class="home-hero__scroll-line" aria-hidden="true"></span>
    </a>
  </section>

  <HomeIntroduction />
</main>
