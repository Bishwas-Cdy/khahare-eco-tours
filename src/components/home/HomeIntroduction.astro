---
import '../../styles/components/home-introduction.css';
---

<section
  id="home-introduction"
  class="home-introduction"
  aria-labelledby="home-introduction-title"
  data-header-theme="dark"
>
  <div class="home-introduction__layout">
    <p class="home-introduction__context type-meta" data-reveal="mask">
      <span data-reveal-inner>
        Nepal <span aria-hidden="true">/</span> Tours &amp; treks
      </span>
    </p>

    <h1 id="home-introduction-title" class="home-introduction__title" data-reveal="mask">
      <span data-reveal-inner>
        <span>Travel deeper</span>
        {' '}
        <span>into Nepal.</span>
      </span>
    </h1>

    <p class="home-introduction__copy" data-reveal="slide-left">
      From Himalayan trails to living culture, Khahare creates journeys shaped by local knowledge,
      nature, and meaningful connection.
    </p>
  </div>
</section>
