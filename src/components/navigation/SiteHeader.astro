---
import { navigationItems } from '../../data/navigation';
import '../../styles/components/site-header.css';

const primaryItems = navigationItems.filter((item) => item.type !== 'cta');
const enquiryItem = navigationItems.find((item) => item.type === 'cta');
---

<header class="site-header" data-site-header data-theme="dark">
  <div class="site-header__bar">
    <a class="site-wordmark" href="/">
      <img
        class="site-wordmark__image"
        src="/images/KHAHARE%20Mountain%20River%20Logo.png"
        alt="Khahare Eco Tours"
        width="1774"
        height="887"
      />
    </a>

    <nav class="desktop-navigation" aria-label="Primary navigation">
      <ul class="desktop-navigation__list">
        {
          primaryItems.map((item) =>
            item.type === 'group' ? (
              <li class="desktop-navigation__item" data-dropdown>
                <button
                  class="desktop-navigation__trigger"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`desktop-submenu-${item.key}`}
                  data-dropdown-toggle
                >
                  <span>{item.label}</span>
                  <span class="desktop-navigation__indicator" aria-hidden="true"></span>
                </button>
                <ul
                  class="desktop-submenu"
                  id={`desktop-submenu-${item.key}`}
                  data-dropdown-menu
                >
                  {item.children.map((child) => <li><a href={child.href}>{child.label}</a></li>)}
                </ul>
              </li>
            ) : (
              <li class="desktop-navigation__item">
                <a class="desktop-navigation__link" href={item.href}>{item.label}</a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    {
      enquiryItem && (
        <a class="site-header__enquire" href={enquiryItem.href}>
          <span>{enquiryItem.label}</span>
          <span aria-hidden="true">↗</span>
        </a>
      )
    }

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      data-menu-toggle
    >
      <span class="menu-toggle__label">Menu</span>
      <span class="menu-toggle__icon" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <div class="mobile-navigation" id="mobile-navigation" data-mobile-menu>
    <div class="mobile-navigation__header">
      <span class="type-meta">Navigation</span>
      <button class="mobile-navigation__close" type="button" data-menu-close>
        <span>Close</span>
        <span aria-hidden="true">×</span>
      </button>
    </div>

    <nav aria-label="Mobile navigation">
      <ul class="mobile-navigation__list">
        {
          navigationItems.map((item) =>
            item.type === 'group' ? (
              <li class="mobile-navigation__group">
                <p>{item.label}</p>
                <ul>
                  {item.children.map((child) => <li><a href={child.href}>{child.label}</a></li>)}
                </ul>
              </li>
            ) : (
              <li class:list={['mobile-navigation__direct', item.type === 'cta' && 'mobile-navigation__cta']}>
                <a href={item.href}>{item.label}</a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

  </div>
</header>

<script>
  import { initNavigation } from '../../scripts/navigation';

  const cleanupNavigation = initNavigation();
  window.addEventListener('pagehide', cleanupNavigation, { once: true });
</script>
