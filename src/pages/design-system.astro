---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/design-system.css';

const palette = [
  { name: 'Warm paper', token: '--color-paper', className: 'swatch--paper' },
  { name: 'Deep forest', token: '--color-forest-deep', className: 'swatch--forest' },
  { name: 'Mineral', token: '--color-mineral', className: 'swatch--mineral' },
  { name: 'Earth', token: '--color-earth', className: 'swatch--earth' },
  { name: 'Muted moss', token: '--color-moss', className: 'swatch--moss' },
];
---

<BaseLayout
  title="Visual Foundation"
  description="A temporary art-direction playground for the Khahare Eco Tours visual foundation."
  bodyClass="design-playground"
  noindex
>
  <header class="playground-header container-wide">
    <a class="playground-mark" href="/" aria-label="Khahare Eco Tours foundation page">
      <span>KET</span>
      <span class="type-meta">Visual studies · 01</span>
    </a>
    <a class="text-link type-meta" href="#principles">
      Begin study <span class="link-arrow" aria-hidden="true">↓</span>
    </a>
  </header>

  <main id="main-content">
    <section class="opening container-wide" aria-labelledby="opening-title">
      <p class="type-meta opening__index" data-reveal="fade" data-reveal-on="intro">
        Foundation / not final art direction
      </p>
      <h1 id="opening-title" class="type-display-1" data-reveal="mask" data-reveal-on="intro">
        <span data-reveal-inner>A quieter kind of grandeur.</span>
      </h1>
      <div class="opening__note" data-reveal="slide-right" data-reveal-on="intro">
        <span class="opening__rule" data-line-draw data-reveal-on="intro" aria-hidden="true"></span>
        <p>
          A temporary visual field for testing scale, rhythm, material, and motion before the first real
          page is composed.
        </p>
      </div>
      <p class="opening__folio type-meta" aria-hidden="true">Nepal · Visual study 01</p>
    </section>

    <section id="principles" class="principles container site-grid" aria-labelledby="principles-title">
      <p class="type-meta principles__label" data-reveal="fade">Design principle</p>
      <div class="principles__statement">
        <h2 id="principles-title" class="type-display-2" data-reveal="mask">
          <span data-reveal-inner>Let space, type, and image carry the weight.</span>
        </h2>
        <p class="type-body-lg">
          This is placeholder copy for evaluating editorial measure. The system should feel grounded and
          human before motion enters the frame.
        </p>
      </div>
      <aside class="principles__aside" data-reveal="slide-left">
        <p class="type-meta">Working tension</p>
        <p>Expedition clarity<br />Hospitality restraint<br />Local warmth</p>
      </aside>
    </section>

    <section class="type-study surface-warm" aria-labelledby="type-title">
      <div class="container-wide">
        <div class="type-study__heading">
          <p class="type-meta">Typography / scale</p>
          <h2 id="type-title" class="type-display-2" data-reveal="mask">
            <span data-reveal-inner>From a whisper to a horizon.</span>
          </h2>
        </div>

        <div class="type-study__specimens" data-stagger>
          <article class="specimen specimen--lead" data-stagger-item>
            <p class="type-meta">Display 01</p>
            <p class="type-display-1">High country.</p>
          </article>
          <article class="specimen specimen--editorial" data-stagger-item>
            <p class="type-meta">Long editorial heading</p>
            <p class="type-h1">
              The landscape should set the pace, not decorate the page.
            </p>
          </article>
          <article class="specimen specimen--body" data-stagger-item>
            <p class="type-meta">Body large / body / meta</p>
            <p class="type-body-lg">
              Placeholder prose for judging cadence, reading comfort, and the relationship between a
              composed headline and useful information.
            </p>
            <p class="type-body text-fade">
              Supporting text stays direct and legible. Generous line height and a controlled measure
              should make practical information feel as considered as the visual storytelling.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="palette container-wide" aria-labelledby="palette-title">
      <div class="palette__intro site-grid">
        <p class="type-meta">Initial palette / adjustable</p>
        <div class="palette__copy">
          <h2 id="palette-title">Borrowed from ground, forest, and stone.</h2>
          <p class="type-body-lg">
            These tones test contrast and atmosphere. They are a starting point, not a locked identity.
          </p>
        </div>
      </div>

      <ol class="palette__swatches" data-stagger aria-label="Initial color studies">
        {
          palette.map((color, index) => (
            <li class:list={['swatch', color.className]} data-stagger-item>
              <span class="swatch__number type-meta">0{index + 1}</span>
              <span class="swatch__name">{color.name}</span>
              <code>{color.token}</code>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="composition" aria-labelledby="composition-title">
      <div class="container-wide composition__grid">
        <div class="composition__copy" data-reveal="slide-right">
          <p class="type-meta">Composition / image behavior</p>
          <h2 id="composition-title">An image can become the architecture.</h2>
          <p class="type-body">
            This abstract frame stands in for future rights-cleared photography. Its crop, overlap, and
            scale are the test—not its content.
          </p>
          <a class="text-link" href="#interactions">
            Continue through the study <span class="link-arrow" aria-hidden="true">↓</span>
          </a>
        </div>

        <figure
          class="image-study image-treatment"
          data-reveal="clip"
          role="img"
          aria-label="Abstract layered landscape placeholder in forest, stone, and earth tones"
        >
          <div class="image-treatment__media image-study__media" data-reveal-media data-parallax>
            <span class="image-study__sky"></span>
            <span class="image-study__ridge image-study__ridge--far"></span>
            <span class="image-study__ridge image-study__ridge--near"></span>
            <span class="image-study__sun"></span>
          </div>
          <figcaption class="type-meta">Abstract image study · no final imagery</figcaption>
        </figure>

        <p class="composition__annotation type-meta">Full bleed / portrait crop / controlled overlap</p>
      </div>
    </section>

    <section class="bleed-study full-bleed surface-sunlit" aria-labelledby="bleed-title">
      <div class="container-wide bleed-study__inner">
        <p class="type-meta">Full-bleed behavior</p>
        <h2 id="bleed-title" class="type-display-2" data-reveal="slide-left">
          Some moments should escape the grid.
        </h2>
        <p class="type-body-lg" data-reveal="fade">
          Placeholder copy for testing a wide, immersive pause between denser editorial passages.
        </p>
      </div>
    </section>

    <section id="interactions" class="interactions container site-grid" aria-labelledby="interactions-title">
      <div class="interactions__intro">
        <p class="type-meta">Primitives / restraint</p>
        <h2 id="interactions-title">Interaction should signal, not shout.</h2>
      </div>
      <div class="interactions__actions" data-reveal="slide-left">
        <a class="button" href="#motion-study">
          Primary action <span class="link-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="button button--secondary" href="#motion-study">Secondary action</a>
        <a class="text-link" href="#motion-study">
          Editorial text link <span class="link-arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="interactions__spacing" aria-label="Spacing scale visualization">
        <p class="type-meta">Spacing rhythm</p>
        <div class="rhythm-lines" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
      </div>
    </section>

    <section id="motion-study" class="motion-study surface-warm" data-scroll-scene aria-labelledby="motion-title">
      <div class="motion-study__sticky container-wide" data-sticky-scene>
        <div class="motion-study__copy">
          <p class="type-meta">Scroll-linked study</p>
          <h2 id="motion-title">Movement with a reason to exist.</h2>
          <p>
            The form shifts with scroll to test pacing and physical coherence. The content remains intact
            when motion is reduced or JavaScript is unavailable.
          </p>
        </div>
        <div class="motion-study__stage" aria-hidden="true">
          <div class="motion-study__form" data-scene-shift>
            <span></span>
          </div>
        </div>
        <p class="motion-study__note type-meta">Scroll / observe / reduce motion supported</p>
      </div>
    </section>

    <section class="measure-study container site-grid" aria-labelledby="measure-title">
      <p class="type-meta measure-study__label">Reading measure</p>
      <article class="measure-study__copy reading-measure" data-reveal="fade">
        <h2 id="measure-title">Practical information can still feel editorial.</h2>
        <p class="type-body-lg">
          This narrow column is a placeholder for future trip context. Clear hierarchy and comfortable
          measure should make dense information useful without turning the page into a dashboard.
        </p>
        <p class="type-body text-muted">
          The final content will be factual and verified. This passage exists only to assess line length,
          paragraph rhythm, spacing, and contrast.
        </p>
      </article>
    </section>

    <footer class="playground-footer surface-dark">
      <div class="container-wide playground-footer__inner">
        <p class="type-meta">End of visual study · foundation 01</p>
        <p class="type-h2">Strong enough before it moves.</p>
        <a class="text-link" href="#main-content">
          Return to the beginning <span class="link-arrow" aria-hidden="true">↑</span>
        </a>
      </div>
    </footer>
  </main>
</BaseLayout>

<script>
  import { initMotion } from '../scripts/motion';

  const cleanupMotion = initMotion();
  window.addEventListener('pagehide', cleanupMotion, { once: true });
</script>
