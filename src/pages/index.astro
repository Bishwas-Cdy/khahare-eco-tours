---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/index.css';
---

<BaseLayout
  title="Foundation"
  description="The visual foundation for the Khahare Eco Tours rebuild is being established."
  bodyClass="foundation-index"
>
  <main id="main-content" class="index-shell">
    <p class="type-meta index-shell__eyebrow">Khahare Eco Tours · Rebuild in progress</p>
    <h1>Foundation before destination.</h1>
    <p class="type-body-lg index-shell__copy">
      The visual language, layout system, and motion behavior are being tested before the homepage is
      art-directed.
    </p>
    <a class="text-link" href="/design-system/">
      View the design playground <span class="link-arrow" aria-hidden="true">↗</span>
    </a>
  </main>
</BaseLayout>
