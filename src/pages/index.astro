---
import HomeHero from '../components/home/HomeHero.astro';
import SiteHeader from '../components/navigation/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/home.css';
---

<BaseLayout
  description="Khahare Eco Tours creates thoughtful tours and treks rooted in Nepal's landscapes and living culture."
  bodyClass="home-page"
>
  <SiteHeader />
  <HomeHero />
</BaseLayout>

<script>
  import { initHomeHero } from '../scripts/home-hero';
  import { initMotion } from '../scripts/motion';

  const cleanupMotion = initMotion();
  const cleanupHomeHero = initHomeHero();

  window.addEventListener(
    'pagehide',
    () => {
      cleanupHomeHero();
      cleanupMotion();
    },
    { once: true },
  );
</script>
